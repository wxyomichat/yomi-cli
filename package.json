{
  "name": "@yomichat/cli",
  "version": "0.1.0",
  "description": "Yomi command-line tool: sign in through the web, create characters from a file, preview-chat with drafts, generate images and videos, and relay your own bot's private chat to a character.",
  "keywords": [
    "yomi",
    "yomichat",
    "cli",
    "ai",
    "ai-character",
    "chat",
    "telegram",
    "relay"
  ],
  "homepage": "https://github.com/wxyomichat/yomi-cli#readme",
  "bugs": {
    "url": "https://github.com/wxyomichat/yomi-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxyomichat/yomi-cli.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.4"
  },
  "bin": {
    "yomi": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/mock",
    "!dist/**/*.map",
    "docs",
    "!docs/release.md",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "prepack": "pnpm clean && pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mock": "pnpm build && node dist/mock/main.js",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/pngjs": "6.0.5",
    "@types/ws": "8.18.1",
    "prettier": "3.8.0",
    "typescript": "5.4.5",
    "vitest": "4.1.9",
    "ws": "8.18.3"
  }
}
